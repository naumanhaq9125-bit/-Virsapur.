{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist-production",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": { "maxDuration": 30 },
    "api/media.js": { "maxDuration": 60 },
    "api/content.js": { "maxDuration": 60, "includeFiles": ["assets/maps/runtime/districts/*.geojson", "assets/maps/pakistan-admin-1.js", "data/districts.js"] }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data: https://*.supabase.co; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'self' https:" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/service/heritageTours",
      "destination": "/service/heritage-tours",
      "permanent": true
    },
    {
      "source": "/service/culturalAndEducationalWorkshops",
      "destination": "/service/cultural-and-educational-workshops",
      "permanent": true
    },
    {
      "source": "/service/researchAndRestorationProjects",
      "destination": "/service/research-and-restoration-projects",
      "permanent": true
    },
    {
      "source": "/service/culturalEventsAndCollaborations",
      "destination": "/service/cultural-events-and-collaborations",
      "permanent": true
    }
  ]
}
