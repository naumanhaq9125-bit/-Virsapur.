# Active environment: localhost-only Studio, Preview, and Local Production.
STUDIO_DATA_MODE=local
PRODUCTION_CMS_ENABLED=false
CUSTOM_TOUR_QUOTES_ENABLED=false
CMS_DATA_MODE=local

# Local clean-release origin used for canonical URLs.
SITE_ORIGIN=http://127.0.0.1:4173/production
PAYMENT_MODE=disabled

# Set PAYMENT_MODE=stripe to enable paid official trip reservations.
# Use Stripe test keys first. Never put secret keys in frontend files or Git.
STRIPE_SECRET_KEY=
# Local testing: `stripe listen --forward-to 127.0.0.1:4173/api/stripe/webhook`
# Copy the CLI's whsec_ signing secret here while the listener is running.
STRIPE_WEBHOOK_SECRET=

# Booking confirmation email. For Gmail, enable 2-Step Verification and use a
# Google App Password here, not your normal Gmail password. Leave blank to disable.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dormant future hosted CMS configuration. The local workflow does not read,
# require, or contact these services while PRODUCTION_CMS_ENABLED=false.
PRODUCTION_ADMIN_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_STORAGE_BUCKET=virsapur-private
SUPABASE_PUBLIC_STORAGE_BUCKET=virsapur-public

# Dormant future hosted publishing configuration.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=
VERCEL_TEAM_ID=
VERCEL_GIT_REPOSITORY_ID=
VERCEL_GIT_PROVIDER=github
VERCEL_GIT_REF=main

# Required only when applying the migration script.
CONFIRM_CMS_MIGRATION=
